---
const services = [
  {
    icon: "layers",
    title: "Desarrollo Full-Stack",
    description:
      "Creación de aplicaciones web completas utilizando las tecnologías más eficientes del mercado. Enfoque en rendimiento, accesibilidad y código limpio.",
    tech: ["Astro", "React", "TypeScript", "Python"],
  },
  {
    icon: "api",
    title: "APIs e Integraciones",
    description:
      "Diseño y desarrollo de APIs REST. Integración con servicios externos como WhatsApp Business API y CRM.",
    tech: ["REST/XML", "FastAPI", "Integraciones"],
  },
  {
    icon: "account_tree",
    title: "N8N",
    description: "Diseño y automatización de flujos de trabajo.",
    tech: ["N8N", "Docker", "GitHub"],
  },
  {
    icon: "speed",
    title: "Optimización y Rendimiento",
    description:
      "Auditoría técnica de plataformas web existentes para acelerar los tiempos de carga, mejorar la experiencia de usuario y optimizar la puntuación SEO.",
    tech: ["Performance Audit", "Web Vitals", "SEO", "Accessibilidad"],
  },
  {
    icon: "settings_suggest",
    title: "Automatización de Procesos",
    description:
      "Automatización de procesos repetitivos y tediosos para ahorrar tiempo y esfuerzo en tareas manuales y repetitivas. ",
    tech: ["Performance Audit", "Web Vitals", "SEO", "Accessibilidad"],
  },
];
---

<section id="servicios" class="services-section reveal">
  <div class="section-header">
    <span class="section-tag">¿Cómo puedo ayudarte?</span>
    <h2 class="section-title">Soluciones Digitales</h2>
    <p class="section-subtitle">
      Desarrollo aplicaciones, conecto sistemas y automatizo procesos para
      mejorar la eficiencia de tu operación.
    </p>
  </div>

  <div class="services-grid">
    {
      services.map((service) => (
        <div class="service-card">
          <md-ripple />
          <div class="service-icon-container">
            <md-icon class="service-icon">{service.icon}</md-icon>
          </div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-description">{service.description}</p>
          <div class="service-tech-list">
            {service.tech.map((tech) => (
              <span class="mini-tag">{tech}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import "@material/web/ripple/ripple.js";
  import "@material/web/icon/icon.js";
</script>

<style>
  .services-section {
    padding: 6rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Cabecera de Sección */
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    font-family: var(--font-mono);
    color: var(--md-sys-color-primary);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-outfit);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--md-sys-color-on-background);
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    color: var(--md-sys-color-on-background);
    opacity: 0.7;
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  /* Grid de Servicios */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  /* Tarjeta de Servicio con Glassmorphism */
  .service-card {
    position: relative;
    overflow: hidden;
    /* Vital para que el ripple no se desborde */
    background: rgba(24, 21, 31, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    transition: var(--transition-swift);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    cursor: pointer;
  }

  .service-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(208, 188, 255, 0.03) 0%,
      transparent 100%
    );
    pointer-events: none;
  }

  .service-card:hover {
    transform: translateY(-8px);
    border-color: rgba(208, 188, 255, 0.15);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  /* Icono */
  .service-icon-container {
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    transition: var(--transition-swift);
  }

  .service-card:hover .service-icon-container {
    background-color: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    transform: scale(1.05);
  }

  .service-icon {
    font-size: 28px;
    width: 28px;
    height: 28px;
  }

  /* Contenido */
  .service-title {
    font-family: var(--font-outfit);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.8rem;
  }

  .service-description {
    font-size: 0.95rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.6;
    margin-bottom: 1.8rem;
    flex-grow: 1;
    /* Empuja los tags al final */
  }

  /* Tags de tecnologías */
  .service-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mini-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    color: var(--md-sys-color-secondary);
  }

  /* Adaptación Móvil */
  @media (max-width: 768px) {
    .services-section {
      padding: 4rem 1.5rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .service-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
