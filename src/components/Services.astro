---
const services = [
  {
    icon: "web",
    title: "Tu Web, Tu Mejor Vendedor",
    description:
      "Construyo aplicaciones web rápidas y atractivas que convierten visitantes en clientes. Deja de perder oportunidades con una plataforma lenta o que no genera confianza.",
    tech: ["Astro", "React", "TypeScript", "Python"],
  },
  {
    icon: "hub",
    title: "Conecta Todo tu Stack",
    description:
      "Integro tus herramientas de negocio entre sí: CRM, WhatsApp Business, plataformas de pago y cualquier sistema externo. Que los datos fluyan solos, sin trabajo manual.",
    tech: ["WhatsApp Business API", "CRM", "FastAPI", "REST"],
  },
  {
    icon: "smart_toy",
    title: "Automatiza tu Operación",
    description:
      "Convierto procesos manuales en flujos automáticos. Notificaciones, reportes, seguimiento de clientes y tareas repetitivas que se ejecutan solas mientras tú te enfocas en crecer.",
    tech: ["N8N", "Docker", "Webhooks", "GitHub"],
  },
  {
    icon: "speed",
    title: "Web que Retiene Clientes",
    description:
      "El 53% de los usuarios abandona si tu web tarda más de 3 segundos. Audito tu plataforma y la optimizo para que cargue en menos de 1 segundo y aparezca primero en Google.",
    tech: ["Web Vitals", "SEO", "Performance Audit", "Accesibilidad"],
  },
];
---

<section id="servicios" class="services-section reveal">
  <div class="section-header">
    <span class="section-tag">El Problema</span>
    <h2 class="section-title">
      ¿Pierdes horas en tareas manuales y repetitivas?
    </h2>
    <p class="section-subtitle">
      Cada hora gastada en hojas de cálculo y procesos ineficientes es tiempo
      que no estás invirtiendo en crecer. Yo me encargo de automatizar tus
      operaciones y desarrollar el software que necesitas para que tu negocio
      funcione en piloto automático.
    </p>
  </div>

  <div class="services-grid">
    {
      services.map((service) => (
        <div class="service-card">
          <md-ripple />
          <div class="service-icon-container">
            <md-icon class="service-icon">{service.icon}</md-icon>
          </div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-description">{service.description}</p>
          <div class="service-tech-list">
            {service.tech.map((tech) => (
              <span class="mini-tag">{tech}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import "@material/web/ripple/ripple.js";
  import "@material/web/icon/icon.js";
</script>

<style>
  .services-section {
    padding: 6rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    font-family: var(--font-mono);
    color: var(--md-sys-color-primary);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-outfit);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--md-sys-color-on-background);
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    color: var(--md-sys-color-on-background);
    opacity: 0.7;
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .service-card {
    position: relative;
    overflow: hidden;
    background: var(--theme-card-bg);
    border: 1px solid var(--theme-card-border);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    transition: var(--transition-swift);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    cursor: pointer;
  }

  .service-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(var(--md-sys-color-primary), 0.03) 0%,
      transparent 100%
    );
    pointer-events: none;
  }

  .service-card:hover {
    transform: translateY(-8px);
    border-color: var(--md-sys-color-primary-container);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  .service-icon-container {
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    transition: var(--transition-swift);
  }

  .service-card:hover .service-icon-container {
    background-color: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    transform: scale(1.05);
  }

  .service-icon {
    font-size: 28px;
    width: 28px;
    height: 28px;
  }

  .service-title {
    font-family: var(--font-outfit);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.8rem;
  }

  .service-description {
    font-size: 0.95rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.6;
    margin-bottom: 1.8rem;
    flex-grow: 1;
  }

  .service-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mini-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--md-sys-color-surface-variant);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    color: var(--md-sys-color-secondary);
  }

  @media (max-width: 768px) {
    .services-section {
      padding: 4rem 1.5rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .service-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
