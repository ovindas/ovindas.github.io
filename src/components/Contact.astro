---

---

<section id="contacto" class="contact-section reveal">
  <div class="contact-container">
    <div class="contact-info">
      <span class="section-tag">Contacto</span>
      <h2 class="contact-title">Agenda tu diagnóstico gratuito</h2>
      <p class="contact-desc">
        Una llamada para entender tu negocio y ver cómo puedo ayudarte a
        automatizar procesos o construir tu próximo producto digital.
      </p>

      <div class="trust-badge">
        <div class="trust-stars">⭐⭐⭐⭐⭐</div>
        <div class="trust-text">
          <strong>Diagnóstico 100% gratuito y sin compromisos</strong>
          <span>Sin tarjeta de crédito · Respuesta en menos de 24h</span>
        </div>
      </div>

      <div
        style="width:100%;height:100%;min-height:650px;overflow:scroll"
        id="my-cal-inline-diagnostico"
      >
      </div>
      <script type="text/javascript">
        (function (C, A, L) {
          let p = function (a, ar) {
            a.q.push(ar);
          };
          let d = C.document;
          C.Cal =
            C.Cal ||
            function () {
              let cal = C.Cal;
              let ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                d.head.appendChild(d.createElement("script")).src = A;
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () {
                  p(api, arguments);
                };
                const namespace = ar[1];
                api.q = api.q || [];
                if (typeof namespace === "string") {
                  cal.ns[namespace] = cal.ns[namespace] || api;
                  p(cal.ns[namespace], ar);
                  p(cal, ["initNamespace", namespace]);
                } else p(cal, ar);
                return;
              }
              p(cal, ar);
            };
        })(window, "https://app.cal.com/embed/embed.js", "init");
        Cal("init", "diagnostico", { origin: "https://app.cal.com" });
        Cal.config = Cal.config || {};
        Cal.config.forwardQueryParams = true;

        Cal.ns.diagnostico("inline", {
          elementOrSelector: "#my-cal-inline-diagnostico",
          config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
          calLink: "vindasdev/diagnostico",
        });

        Cal.ns.diagnostico("ui", {
          hideEventTypeDetails: false,
          layout: "month_view",
        });
      </script>
    </div>
  </div>

  <style>
    .contact-section {
      padding: 6rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
      box-sizing: border-box;
    }

    .contact-container {
      display: grid;
      grid-template-columns: 1fr;
      background: var(--theme-card-bg);
      border: 1px solid var(--theme-card-border);
      border-radius: 24px;
      padding: 4rem;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .section-tag {
      font-family: var(--font-mono);
      color: var(--md-sys-color-primary);
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 0.5rem;
    }

    .contact-title {
      font-family: var(--font-outfit);
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--md-sys-color-on-background);
      margin-bottom: 1.5rem;
      letter-spacing: -0.5px;
    }

    .contact-desc {
      font-size: 1.05rem;
      color: var(--md-sys-color-on-surface-variant);
      line-height: 1.6;
      margin-bottom: 3rem;
    }

    .info-items {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .info-item {
      display: flex;
      align-items: center;
      gap: 1.2rem;
    }

    .info-icon {
      background-color: var(--md-sys-color-surface-variant);
      color: var(--md-sys-color-primary);
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .info-item h4 {
      font-size: 0.9rem;
      color: var(--md-sys-color-secondary);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 500;
    }

    .info-item a,
    .info-item p {
      font-size: 1.05rem;
      color: var(--md-sys-color-on-background);
      text-decoration: none;
      transition: var(--transition-swift);
    }

    .info-item a:hover {
      color: var(--md-sys-color-primary);
    }

    .contact-form-wrapper {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .contact-form {
      display: flex;
      flex-direction: column;
    }

    md-outlined-text-field {
      width: 100%;
      margin-bottom: 1.8rem;
      --md-outlined-text-field-container-shape: 12px;
      --md-outlined-text-field-outline-color: rgba(255, 255, 255, 0.15);
      --md-outlined-text-field-hover-outline-color: var(--md-sys-color-primary);
      --md-outlined-text-field-focus-outline-color: var(--md-sys-color-primary);
      --md-outlined-text-field-label-text-color: var(
        --md-sys-color-on-surface-variant
      );
      --md-outlined-text-field-focus-label-text-color: var(
        --md-sys-color-primary
      );
      --md-outlined-text-field-input-text-color: var(--md-sys-color-on-surface);
      --md-outlined-text-field-leading-icon-color: var(--md-sys-color-primary);
      --md-outlined-text-field-focus-leading-icon-color: var(
        --md-sys-color-primary
      );
      font-family: var(--font-outfit);
    }

    .form-actions {
      margin-top: 0.5rem;
    }

    #submit-button {
      --md-filled-button-label-text-font: var(--font-outfit);
      --md-filled-button-label-text-weight: 600;
      --md-filled-button-container-height: 48px;
      font-family: var(--font-outfit);
      font-weight: 600;
    }

    .feedback-msg {
      display: none;
      align-items: center;
      gap: 0.8rem;
      padding: 1rem 1.2rem;
      border-radius: 12px;
      margin-top: 1.5rem;
      font-size: 0.95rem;
      font-weight: 500;
      animation: slideDown 0.3s ease forwards;
    }

    .feedback-msg.show {
      display: flex;
    }

    .success-msg {
      background-color: rgba(76, 175, 80, 0.1);
      border: 1px solid rgba(76, 175, 80, 0.2);
      color: #81c784;
    }

    .error-msg {
      background-color: rgba(244, 67, 54, 0.1);
      border: 1px solid rgba(244, 67, 54, 0.2);
      color: #e57373;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .trust-badge {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: rgba(var(--md-sys-color-primary-rgb, 103, 80, 164), 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 1rem 1.4rem;
      margin-bottom: 2rem;
    }

    .trust-stars {
      font-size: 1.1rem;
      letter-spacing: 2px;
      white-space: nowrap;
    }

    .trust-text {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .trust-text strong {
      font-size: 0.95rem;
      color: var(--md-sys-color-on-background);
      font-weight: 600;
    }

    .trust-text span {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--md-sys-color-on-surface-variant);
      opacity: 0.75;
    }

    @media (max-width: 900px) {
      .contact-container {
        padding: 3rem 2rem;
      }

      .contact-title {
        font-size: 2rem;
      }

      .contact-desc {
        margin-bottom: 2rem;
      }
    }

    @media (max-width: 480px) {
      .contact-section {
        padding: 4rem 1rem;
      }

      .contact-container {
        padding: 2rem 1.2rem;
      }
    }
  </style>
</section>
