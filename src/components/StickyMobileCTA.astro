---
const baseUrl = import.meta.env.BASE_URL;
---

<div id="sticky-mobile-cta" class="sticky-cta" aria-label="Agendar llamada">
  <div class="sticky-cta-inner">
    <div class="sticky-cta-text">
      <span class="sticky-cta-title">¿Listo para automatizar?</span>
      <span class="sticky-cta-sub">Diagnóstico gratuito · Sin compromisos</span>
    </div>
    <a href={`${baseUrl}#contacto`} class="sticky-cta-btn"> Agendar llamada </a>
  </div>
</div>

<script>
  const stickyCta = document.getElementById("sticky-mobile-cta");
  const hero = document.querySelector(".hero-section") as HTMLElement | null;

  if (stickyCta && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          stickyCta.classList.add("visible");
        } else {
          stickyCta.classList.remove("visible");
        }
      },
      { threshold: 0.1 },
    );
    observer.observe(hero);
  }
</script>

<style>
  .sticky-cta {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--md-sys-color-surface);
    border-top: 1px solid var(--theme-card-border);
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.3);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sticky-cta.visible {
    transform: translateY(0);
  }

  .sticky-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .sticky-cta-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .sticky-cta-title {
    font-family: var(--font-outfit);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--md-sys-color-on-background);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-cta-sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--md-sys-color-on-surface-variant);
    opacity: 0.7;
    white-space: nowrap;
  }

  .sticky-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0.65rem 1.4rem;
    border-radius: 100px;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-family: var(--font-outfit);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      filter 0.2s ease,
      transform 0.2s ease;
  }

  .sticky-cta-btn:hover,
  .sticky-cta-btn:active {
    filter: brightness(1.1);
    transform: scale(1.03);
  }

  @media (max-width: 768px) {
    .sticky-cta {
      display: block;
    }
  }
</style>
