---
const baseUrl = import.meta.env.BASE_URL;
---

<header id="main-header">
  <a href={`${baseUrl}#`} class="logo">
    <span>&lt;</span>JVindas<span>/&gt;</span>
  </a>

  <!-- Enlaces de navegación de escritorio -->
  <nav class="nav-container">
    <div class="nav-links" id="nav-links">
      <a href={`${baseUrl}#`} class="nav-link">Inicio</a>
      <a href={`${baseUrl}#servicios`} class="nav-link">Servicios</a>
      <a href={`${baseUrl}#experiencia`} class="nav-link">Experiencia</a>
      <a href={`${baseUrl}#habilidades`} class="nav-link">Habilidades</a>
      <a href={`${baseUrl}#contacto`} class="nav-link">Contacto</a>
      <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar tema">
        <span class="material-symbols-outlined theme-icon" id="theme-icon"
          >dark_mode</span
        >
      </button>
      <md-outlined-button
        data-cal-link="vindasdev/diagnostico"
        data-cal-namespace="diagnostico"
        data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
        class="header-btn"
        style="cursor: pointer;"
      >
        Contratar
      </md-outlined-button>
    </div>

    <!-- Botón de Menú Móvil -->
    <button class="menu-toggle" id="menu-toggle" aria-label="Abrir menú">
      <span class="material-symbols-outlined icon-menu">menu</span>
      <span class="material-symbols-outlined icon-close" style="display: none;">
        close
      </span>
    </button>
  </nav>
</header>

<!-- Menú móvil desplegable -->
<div class="mobile-nav" id="mobile-nav">
  <a href={`${baseUrl}#`} class="mobile-link">Inicio</a>
  <a href={`${baseUrl}#servicios`} class="mobile-link">Servicios</a>
  <a href={`${baseUrl}#experiencia`} class="mobile-link">Experiencia</a>
  <a href={`${baseUrl}#contacto`} class="mobile-link">Contacto</a>
  <button
    id="theme-toggle-mobile"
    class="theme-toggle theme-toggle--mobile"
    aria-label="Cambiar tema"
  >
    <span class="material-symbols-outlined theme-icon" id="theme-icon-mobile"
      >dark_mode</span
    >
    <span class="theme-toggle-label" id="theme-label-mobile">Tema oscuro</span>
  </button>
  <md-outlined-button class="header-btn" href={`${baseUrl}#contacto`}>
    Contratar
  </md-outlined-button>
</div>

<section>
  <!-- Cal element-click embed code begins -->
  <script type="text/javascript">
    (function (C, A, L) {
      let p = function (a, ar) {
        a.q.push(ar);
      };
      let d = C.document;
      C.Cal =
        C.Cal ||
        function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () {
              p(api, arguments);
            };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
    })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "diagnostico", { origin: "https://app.cal.com" });
    Cal.config = Cal.config || {};
    Cal.config.forwardQueryParams = true;

    // Important: Please add the following attributes to the element that should trigger the calendar to open upon clicking.
    // `data-cal-link="vindasdev/diagnostico"`
    // data-cal-namespace="diagnostico"
    // `data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'`

    Cal.ns.diagnostico("ui", {
      hideEventTypeDetails: false,
      layout: "month_view",
    });
  </script>
  <!-- Cal element-click embed code ends -->
</section>

<script>
  import "@material/web/button/outlined-button.js";
  import "@material/web/button/filled-button.js";

  // ── Lógica del tema claro / oscuro ──
  const themeToggle = document.getElementById("theme-toggle");
  const themeToggleMobile = document.getElementById("theme-toggle-mobile");
  const themeIcon = document.getElementById("theme-icon") as HTMLElement;
  const themeIconMobile = document.getElementById(
    "theme-icon-mobile",
  ) as HTMLElement;
  const themeLabelMobile = document.getElementById(
    "theme-label-mobile",
  ) as HTMLElement;

  function getTheme(): string {
    return document.documentElement.getAttribute("data-theme") || "dark";
  }

  function updateThemeUI(theme: string) {
    const icon = theme === "dark" ? "light_mode" : "dark_mode";
    const label = theme === "dark" ? "Tema claro" : "Tema oscuro";
    if (themeIcon) themeIcon.textContent = icon;
    if (themeIconMobile) themeIconMobile.textContent = icon;
    if (themeLabelMobile) themeLabelMobile.textContent = label;
  }

  function toggleTheme() {
    const current = getTheme();
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    updateThemeUI(next);
  }

  // Inicializar UI según el tema activo al cargar
  updateThemeUI(getTheme());

  themeToggle?.addEventListener("click", toggleTheme);
  themeToggleMobile?.addEventListener("click", toggleTheme);

  // ── Lógica del header adhesivo (sticky) y menú móvil ──
  const header = document.getElementById("main-header");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  const iconMenu = document.querySelector(".icon-menu") as HTMLElement;
  const iconClose = document.querySelector(".icon-close") as HTMLElement;
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Sticky header al hacer scroll
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header?.classList.add("scrolled");
    } else {
      header?.classList.remove("scrolled");
    }
  });

  // Alternar el menú móvil
  function toggleMenu() {
    const isOpen = mobileNav?.classList.toggle("open");
    if (isOpen) {
      if (iconMenu) iconMenu.style.display = "none";
      if (iconClose) iconClose.style.display = "inline-block";
      document.body.style.overflow = "hidden"; // Evita scroll de fondo
    } else {
      if (iconMenu) iconMenu.style.display = "inline-block";
      if (iconClose) iconClose.style.display = "none";
      document.body.style.overflow = "";
    }
  }

  menuToggle?.addEventListener("click", toggleMenu);

  // Cerrar menú móvil al hacer clic en un enlace
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      mobileNav?.classList.remove("open");
      if (iconMenu) iconMenu.style.display = "inline-block";
      if (iconClose) iconClose.style.display = "none";
      document.body.style.overflow = "";
    });
  });
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.8rem 2rem;
    transition: var(--transition-swift);
    box-sizing: border-box;
  }

  header.scrolled {
    background-color: var(--theme-header-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 1.2rem 2rem;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid var(--theme-card-border);
  }

  /* Logotipo */
  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--md-sys-color-on-background);
    text-decoration: none;
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
    transition: var(--transition-swift);
  }

  .logo span {
    color: var(--md-sys-color-primary);
    transition: var(--transition-swift);
  }

  .logo:hover {
    transform: scale(1.03);
  }

  .logo:hover span {
    filter: drop-shadow(0 0 8px var(--md-sys-color-primary));
  }

  /* Contenedor de Navegación */
  .nav-container {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-outfit);
    font-weight: 500;
    color: var(--md-sys-color-on-background);
    text-decoration: none;
    font-size: 0.95rem;
    transition: var(--transition-swift);
    opacity: 0.85;
    position: relative;
    padding: 0.2rem 0;
  }

  /* Efecto underline en hover */
  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--md-sys-color-primary);
    transition: var(--transition-swift);
  }

  .nav-link:hover {
    opacity: 1;
    color: var(--md-sys-color-primary);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Botón de Menú Móvil */
  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--md-sys-color-on-background);
    cursor: pointer;
    padding: 0.5rem;
    outline: none;
  }

  /* Estilos del menú móvil desplegable */
  .mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--theme-nav-bg);
    z-index: 99;

    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    padding: 2rem;
    box-sizing: border-box;
    transform: translateY(-100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-nav.open {
    transform: translateY(0);
  }

  .mobile-link {
    font-family: var(--font-outfit);
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--md-sys-color-on-background);
    text-decoration: none;
    transition: var(--transition-swift);
  }

  .mobile-link:hover {
    color: var(--md-sys-color-primary);
    transform: scale(1.05);
  }

  .header-btn {
    --md-filled-button-label-text-font: var(--font-outfit);
    --md-outlined-button-label-text-font: var(--font-outfit);
    --md-filled-button-label-text-weight: 500;
    --md-outlined-button-label-text-weight: 500;
    font-family: var(--font-outfit);
  }

  md-outlined-button {
    padding: 10px 24px;
  }

  /* Botón de toggle de tema */
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--md-sys-color-on-background);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: var(--transition-swift);
    padding: 0;
    outline: none;
  }

  .theme-toggle:hover {
    background-color: var(--md-sys-color-surface-variant);
    color: var(--md-sys-color-primary);
  }

  .theme-toggle .theme-icon {
    font-size: 22px;
    transition:
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
  }

  .theme-toggle:active .theme-icon {
    transform: rotate(30deg) scale(0.85);
    opacity: 0.7;
  }

  /* Botón móvil con etiqueta */
  .theme-toggle--mobile {
    width: auto;
    height: auto;
    border-radius: 16px;
    padding: 0.8rem 1.4rem;
    gap: 0.6rem;
    background-color: var(--md-sys-color-surface-variant);
  }

  .theme-toggle--mobile:hover {
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .theme-toggle-label {
    font-family: var(--font-outfit);
    font-size: 1rem;
    font-weight: 500;
  }
  /* Responsivo */
  @media (max-width: 768px) {
    .mobile-nav {
      display: flex;
    }

    header {
      padding: 1.2rem 1.5rem;
    }

    header.scrolled {
      padding: 1rem 1.5rem;
    }

    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: block;
      z-index: 101;
    }
  }
</style>
